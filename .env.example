# Read securely from the deployment secret store. Never commit actual values.
# app.py does not load this file automatically.
ROUTER_AUTH_TOKEN=
GROQ_API_KEY=
# Set true only after verifying the account is on the finite Free Plan,
# no paid billing path, and applicable model/data policies are acceptable.
GROQ_FREE_PLAN_CONFIRMED=false
# An existing durable volume is required, mounted writable by one replica/worker.
ROUTER_STATE_PATH=/data/router-budget.sqlite3
ROUTER_STATE_DURABLE_CONFIRMED=false
ROUTER_DAILY_REQUEST_LIMIT=40
ROUTER_DAILY_TOKEN_LIMIT=40000
ROUTER_MIN_INTERVAL_SECONDS=3
ROUTER_TOTAL_TIMEOUT_SECONDS=15
# Optional future route: unqualified until its exact free endpoint/provider exists.
# Public model endpoints list was EMPTY on 2026-10-17. Leave disabled.
OPENROUTER_API_KEY=
OPENROUTER_FREE_CONFIRMED=false
OPENROUTER_PROVIDER=Groq
PORT=8080
